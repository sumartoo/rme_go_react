# Database PostgreSQL yang terinstal di server.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
DATABASE_URL=postgres://rme:PasswordKuatDiSini@host.docker.internal:5432/new_rme?sslmode=disable

# Secret untuk tanda tangan JWT, minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_HASIL_openssl_rand_hex_32

# Lama sesi tanpa aktivitas sebelum otomatis logout
JWT_TTL=15m

# Di produksi keduanya dimatikan
SWAGGER_ENABLED=false
SEED_DEMO_USERS=false

# Port aplikasi di server. Buka http://IP-SERVER/ kalau 80.
FRONTEND_PORT=80
BACKEND_PORT=8080

# Ditulis otomatis oleh setiap deploy: ghcr.io/<owner-github>/<repo> (huruf kecil) dan commit SHA.
# Isi manual hanya kalau perlu menjalankan "docker compose" sebelum deploy pertama.
# IMAGE_PREFIX=ghcr.io/<owner>/<repo>
# IMAGE_TAG=latest
