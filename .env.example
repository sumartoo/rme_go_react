# Copy to .env and adjust: cp .env.example .env

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=authdb

# JWT signing secret (HS256) - at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Token lifetime = inactivity timeout (Go duration format: 15m, 1m, 30s)
JWT_TTL=15m

# Swagger UI at http://localhost:8080/swagger/ - set to false (or remove) in production
SWAGGER_ENABLED=true

# Create demo users admin@medika.com, cs@medika.com, perawat@medika.com (password Medika123)
# on startup if they do not exist. Set to false (or remove) in production
SEED_DEMO_USERS=true

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=5432

# n8n AI workflow for complaint analysis (Part 2). Leave N8N_WEBHOOK_URL empty to disable.
# The same secret is sent to n8n and required on n8n's callback, as header X-Webhook-Secret.
# Generate one with: openssl rand -hex 24
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Per-attempt timeout and total attempts (retry with backoff 2s, 4s, ...)
N8N_TIMEOUT=30s
N8N_MAX_RETRIES=3
# How n8n reaches this backend; sent to n8n as callbackUrl (empty = n8n must know the URL itself)
PUBLIC_BASE_URL=

# DeepSeek API for Stok Farmasi > Analitik (AI summary and chat). Leave empty to disable the
# assistant; the forecasts and trends still work. Only aggregates (drug names, ICD codes,
# counts) are sent to the API (servers outside Indonesia), never patient data.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# Per question, including the assistant's data lookups
AI_TIMEOUT=120s
